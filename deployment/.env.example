# Copy to `.env` on the server and fill it in. Not in git: this is the one file that differs
# between machines, and it holds the secrets, so keep it readable by the deploy user alone
# (chmod 600 .env). CI never overwrites it, only its TAG line.

# Port the host's nginx proxies /exchange/ into. Bound to 127.0.0.1 by compose.
# Any free one: `ss -ltn` shows the taken ones.
APP_PORT=8090

# The database on the host's PostgreSQL, see README.md.
DB_NAME=exchange
DB_USER=exchange
DB_PASSWORD=

# Signs user tokens. At least 32 bytes: `openssl rand -base64 48`.
# Changing it signs everyone out; guests lose their accounts, since the token is their only key.
AUTH_SECRET=

# Shared by core and the bots for the internal API: `openssl rand -hex 32`.
INTERNAL_TOKEN=

# Kafka runs as this user to write ./kafka-data. Set to `id -u deploy`.
APP_UID=1000

# Order and cancel requests per second of all bots together.
BOT_ORDERS_PER_SECOND=1

# Which build is running. CI overwrites this on deploy; setting it by hand to
# an older commit is how a rollback works.
TAG=latest
